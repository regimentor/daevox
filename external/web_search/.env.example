HOST=127.0.0.1
PORT=8080
# Set this when exposing the service beyond localhost.
# API_KEY=change-me
USER_AGENT=LocalAIWebSearch/1.0

SEARCH_TIMEOUT=8
SEARCH_MAX_CONCURRENCY=4
SEARCH_CACHE_TTL=60
# Comma-separated DDGS text backends. Keep this list explicit and review it when DDGS changes.
SEARCH_BACKEND_ALLOWLIST=auto,bing,brave,duckduckgo,google,grokipedia,mojeek,startpage,yandex,yahoo,wikipedia

HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=10
HTTP_POOL_TIMEOUT=5
HTTP_MAX_RESPONSE_BYTES=5242880
OPEN_DEFAULT_MAX_CHARS=50000
OPEN_HARD_MAX_CHARS=200000
OPEN_CACHE_TTL=300
MAX_REDIRECTS=5

BROWSER_MAX_CONCURRENCY=2
BROWSER_NAVIGATION_TIMEOUT=15000
BROWSER_RENDER_TIMEOUT=20000
BROWSER_STABILIZATION_TIMEOUT=750
BROWSER_BLOCK_STYLESHEETS=false
BROWSER_ENABLED=true

PDF_MAX_BYTES=15728640
PDF_MAX_PAGES=100
CACHE_MAX_ITEMS=500

