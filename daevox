#!/bin/sh

set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WEB_SEARCH_PID=
DESKTOP_PID=
DIEVOX_MODEL=unsloth/GLM-4.7-Flash-GGUF:UD-Q4_K_XL
REFRESH_STORAGE=0

for arg in "$@"; do
    case "$arg" in
        --refresh-storage)
            REFRESH_STORAGE=1
            ;;
        *)
            echo "daevox: unknown argument: $arg" >&2
            exit 2
            ;;
    esac
done

cleanup() {
    status=$?
    trap - EXIT INT TERM

    if [ -n "$WEB_SEARCH_PID" ]; then
        kill "$WEB_SEARCH_PID" 2>/dev/null || true
        wait "$WEB_SEARCH_PID" 2>/dev/null || true
    fi

    if [ -n "$DESKTOP_PID" ]; then
        kill "$DESKTOP_PID" 2>/dev/null || true
        wait "$DESKTOP_PID" 2>/dev/null || true
    fi

    exit "$status"
}

trap cleanup EXIT
trap 'exit 130' INT TERM

if ! command -v npm >/dev/null 2>&1; then
    echo "daevox: npm is required" >&2
    exit 127
fi

if ! command -v uv >/dev/null 2>&1; then
    echo "daevox: uv is required to run external/web_search" >&2
    exit 127
fi

cd "$ROOT_DIR"

echo "[daevox] Building packages..."
npm run build

STORAGE_DIR="$ROOT_DIR/packages/storage"
STORAGE_DATABASE="$STORAGE_DIR/prisma/dev.db"

if [ "$REFRESH_STORAGE" -eq 1 ]; then
    echo "[daevox] Refreshing storage database..."
    rm -f "$STORAGE_DATABASE"
fi

echo "[daevox] Applying storage migrations..."
(
    cd "$STORAGE_DIR"
    npm run migrate
)

echo "[daevox] Rebuilding native modules for Electron..."
npx @electron/rebuild -w better-sqlite3 -v 43.3.0

echo "[daevox] Starting web_search (logs below)..."
(
    cd "$ROOT_DIR/external/web_search"
    exec uv run uvicorn websearch.main:app --host 127.0.0.1 --port 9000
) &
WEB_SEARCH_PID=$!

echo "[daevox] Starting desktop (logs below)..."
(
    cd "$ROOT_DIR"
    exec npm --workspace @daevox/desktop run start
) &
DESKTOP_PID=$!

# Keep this shell alive while the desktop application is running.  Its exit
# triggers cleanup(), which also stops web_search.
wait "$DESKTOP_PID"
