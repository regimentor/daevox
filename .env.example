# Shared daevox configuration. Copy to .env at the repository root.

# Node/orchestrator
DAEVOX_MODEL=unsloth/GLM-4.7-Flash-GGUF:UD-Q4_K_XL
DAEVOX_ORCHESTRATOR_HOST=127.0.0.1
DAEVOX_ORCHESTRATOR_PORT=8787
DAEVOX_MEMORY_GROOMER_BASE_URL=http://localhost:8080/v1
# DAEVOX_MEMORY_GROOMER_MODEL=...
# OPENAI_API_KEY=...

# Memory service
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8765
# Leave empty to use <repository>/.vault when started through ./daevox.
# MEMORY_VAULT_PATH=/absolute/path/to/vault
MEMORY_DATA_PATH=./data
MEMORY_DB_PATH=./data/index.sqlite
MEMORY_OPENAPI_PATH=./openapi.yaml
MEMORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBEDDING_DEVICE=cuda:0
MEMORY_EMBEDDING_PROVIDER=sentence-transformers
MEMORY_WATCH_ENABLED=true
MEMORY_WATCH_DEBOUNCE_MS=400
MEMORY_GIT_ENABLED=true
MEMORY_GIT_AUTO_COMMIT=false
MEMORY_GIT_AUTHOR_NAME=
MEMORY_GIT_AUTHOR_EMAIL=
MEMORY_SEARCH_DEFAULT_LIMIT=10
MEMORY_KEYWORD_CANDIDATES=30
MEMORY_SEMANTIC_CANDIDATES=30
MEMORY_RRF_K=60
MEMORY_CHUNK_TARGET_TOKENS=600
MEMORY_CHUNK_MAX_TOKENS=1000
MEMORY_CHUNK_OVERLAP_TOKENS=80

# Web search service
HOST=127.0.0.1
PORT=9000
# API_KEY=
USER_AGENT=LocalAIWebSearch/1.0
SEARCH_TIMEOUT=8
SEARCH_MAX_CONCURRENCY=4
SEARCH_CACHE_TTL=60
SEARCH_BACKEND_ALLOWLIST=auto,bing,brave,duckduckgo,google,grokipedia,mojeek,startpage,yandex,yahoo,wikipedia
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=10
HTTP_POOL_TIMEOUT=5
HTTP_MAX_RESPONSE_BYTES=5242880
OPEN_DEFAULT_MAX_CHARS=50000
OPEN_HARD_MAX_CHARS=200000
OPEN_CACHE_TTL=300
MAX_REDIRECTS=5
BROWSER_MAX_CONCURRENCY=2
BROWSER_NAVIGATION_TIMEOUT=15000
BROWSER_RENDER_TIMEOUT=20000
BROWSER_STABILIZATION_TIMEOUT=750
BROWSER_BLOCK_STYLESHEETS=false
BROWSER_ENABLED=true
PDF_MAX_BYTES=15728640
PDF_MAX_PAGES=100
CACHE_MAX_ITEMS=500
